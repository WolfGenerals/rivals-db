# ─────────────────────────────────────────────────────────
# 游戏原始资产：不入库
#
# 这些是 EA 的版权资产，体积也大（APK 92 MiB + 解包树 294 MiB）。
# 请自行从设备提取（见 README「从哪里获取数据」），放到 tmp/ 下即可。
# ─────────────────────────────────────────────────────────
tmp/

# 兼容：万一有人把资产放在仓库根（历史布局）
/1_13_0new.apk.1
*.apk
*.apk.1
/com.ea.gp.candcwarzones/

# ─────────────────────────────────────────────────────────
# 以下**应该**入库，仅在此说明意图，勿忽略：
#   data/       提取产物（data/*/*.json + index.json）
#   reference/  参考实现（Python + lupa，重写实现的校验基准）
#   core/       共享纯逻辑（TS，CLI 与网页共用）
#   cli/        命令行
#   web/        网页
#   docs/       文档
# ─────────────────────────────────────────────────────────

# Python 生成物
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# 虚拟环境
.venv
.uv-cache/

# Node / pnpm
node_modules/
.pnpm-store/

# 临时输出
/out/

# 反解过程中的一次性脚本（下划线前缀）
_*.py
_*.mjs
_*.js
_*.ps1
_*.ts

# 网页构建时从 data/ 同步进来的副本（唯一真相是仓库根的 data/）
/web/public/data/
