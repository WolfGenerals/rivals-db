{
  "name": "rivals-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "web": "pnpm --filter @rivals/web dev",
    "web:build": "pnpm --filter @rivals/web build",
    "cli": "pnpm --filter @rivals/cli start",
    "extract": "uv run rivals extract tmp/com.ea.gp.candcwarzones"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
